   "source": [
    "\n",
    "import pymupdf\n",
    "\n",
    "pdf_path = \"annual_report.pdf\"\n",
    "\n",
    "doc = pymupdf.open(pdf_path)\n",
    "\n",
    "for page_num, page in enumerate(doc, start=1):\n",
    "    text = page.get_text()\n",
    "\n",
    "    print(f\"\\n{'=' * 30} PAGE {page_num} {'=' * 30}\\n\")\n",
    "    print(text)\n",
    "\n",
    "doc.close()"
   ]
  }
